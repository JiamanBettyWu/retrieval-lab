.venv/
__pycache__/
*.pyc
# BEIR downloads — rebuildable. `data/*` rather than `data/`: git does not
# descend into an excluded directory, so a `!` exception under `data/` would
# never be consulted. Phase 4's hand labels are the one input that cannot be
# regenerated, so they are re-included below.
data/*
!data/labels/
cache/
# Phase 2 LoRA adapters — rebuildable from the lockfile + recorded config
models/
reports/*.json
.env
.weave/
wandb/
scratch.ipynb
# build artifacts (a plain `pip install -e .` leaves these; uv does not)
build/
dist/
*.egg-info/
.pytest_cache/
